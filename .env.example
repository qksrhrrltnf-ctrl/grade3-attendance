# 복사해서 .env 로 저장 (git에 올라가지 않음). GitHub Actions 에서는 Secrets 로 같은 이름으로 설정.
VITE_SHEET_ID=구글_시트_ID

# Firebase 웹 앱 설정 (콘솔 → 프로젝트 설정 → 내 앱)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 관리자 계정 (firestore.rules 의 이메일과 같아야 함)
VITE_ADMIN_EMAIL=admin@g3-attendance.app
ADMIN_PASSWORD=                # 시드 스크립트 전용, 빌드에 포함되지 않음

# 로컬 에뮬레이터로 테스트할 때 1
VITE_USE_EMULATOR=0
